<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign publications = data[1] | sort: 'releaseDate' | reverse %}
  {% for content in publications %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.releaseDate %} {% assign date = content.releaseDate | split: '-' | join: '.' %} {% else %} {% assign date = '' %} {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ date }}</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ content.url }}">{{ content.name }}</a>
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.publisher }}</h6>
          {% comment %}
            Underline the author's own name, as _layouts/bib.liquid does on the publications
            page. The name comes from the same `scholar` keys in _config.yml that bib.liquid
            uses, so it is not hardcoded here. The trailing group keeps any authorship marker
            († equal contribution, * corresponding) inside the underline, matching bib.liquid.
          {% endcomment %}
          {% assign self_first = site.scholar.first_name | first %}
          {% assign self_last = site.scholar.last_name | first %}
          {% capture self_pattern %}{{ self_first }} {{ self_last }}([*∗†‡§¶‖]*){% endcapture %}
          {% capture self_replacement %}<em class="self">{{ self_first }} {{ self_last }}\1</em>{% endcapture %}
          <h6 class="ml-1 ml-md-4 summary" style="font-size: 0.8rem; font-style: italic">
            {{- content.summary | regex_replace: self_pattern, self_replacement -}}
          </h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
